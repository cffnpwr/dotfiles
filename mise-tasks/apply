#!/usr/bin/env bash
#MISE description="Apply the configuration to this host"
set -eu

if [ "$#" -gt 1 ]; then
  printf 'usage: apply [host]\n' >&2
  exit 1
fi

dotfiles_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
# flake.nixのnixConfigを確認なしで使用
export NIX_CONFIG="${NIX_CONFIG:-}
accept-flake-config = true"

os=$(uname -s)
case "$os" in
Darwin)
  host=${1:-$(scutil --get LocalHostName)}
  # sudoはNIX_CONFIGを引き継がないため、同じ設定を引数で渡す
  # 初回はtrusted-usersが未設定のため、flake.nixのsubstituterを使えるrootでビルド
  darwin_rebuild=$(sudo -H nix build --no-link --print-out-paths --option accept-flake-config true \
    "$dotfiles_dir#darwinConfigurations.$host.config.system.build.darwin-rebuild")
  sudo "$darwin_rebuild/bin/darwin-rebuild" switch \
    --option accept-flake-config true --flake "$dotfiles_dir#$host"
  ;;
Linux)
  host=${1:-$(uname -n)}
  if grep -Eq '^ID="?nixos"?$' /etc/os-release; then
    nixos-rebuild switch --sudo --flake "$dotfiles_dir#$host"
  else
    nix run --inputs-from "$dotfiles_dir" system-manager -- \
      switch --sudo --flake "$dotfiles_dir#$host"
  fi
  ;;
*)
  printf 'unsupported OS: %s (supported: Darwin, Linux)\n' "$os" >&2
  exit 1
  ;;
esac
