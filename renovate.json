{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cffnpwr/renovate-config"],
  "ignorePaths": [
    // NOTE: `mise lock`で生成されるためignore
    ".mise/locks/**"
  ],
  "gitIgnoredAuthors": [
    // NOTE: flake.lockの更新をコミットするGitHub App
    "262637860+cffnpwr-update-bot[bot]@users.noreply.github.com"
  ],
  "nix": {
    // NOTE: nixのmanagerはflake.lockのノード名をinput名として扱い、ルートのnixpkgs・flake-partsの代わりに推移的な依存のノードを抽出するため、flake.lock全体を更新
    "lockFileMaintenance": { "enabled": true }
  },
  "packageRules": [
    {
      // NOTE: git-refsのdatasourceはFlakeHubのURLからGitの参照を取得できず、lookupが失敗するため無効化
      "matchManagers": ["nix"],
      "matchPackageNames": ["/^https://flakehub\\.com//"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      // NOTE: install.shが初回の導入に使うDeterminate Nix Installerのバージョン
      "customType": "regex",
      "managerFilePatterns": ["/^install\\.sh$/"],
      "matchStrings": [
        "https://install\\.determinate\\.systems/nix/tag/(?<currentValue>v[0-9][^'\"\\s]*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "DeterminateSystems/nix-installer"
    },
    {
      // NOTE: nixのmanagerはflake.nixのinputのタグを更新しないため、jdx/miseのflakeのタグを更新
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["github:jdx/mise/(?<currentValue>v[0-9][^\"]*)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise"
    },
    {
      // NOTE: miseのタスクがgo runで実行する、cffnpwr/actionsのGoのプログラムのmainのコミット
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "github\\.com/cffnpwr/actions/[^@\\s]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/cffnpwr/actions",
      "depNameTemplate": "cffnpwr/actions"
    }
  ]
}
