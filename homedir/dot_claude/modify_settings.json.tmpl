#!/usr/bin/env bash
# ~/.claude/settings.json は Claude Code 自身が実行時に書き換える(揮発キーの追加・キー順の正規化)。
# そのため静的管理せず、宣言したキーだけを強制し、他は現在値を保つ。jq は brew 導入のため PATH を補う。
# 出力は -S でアルファベット順にし、Claude Code の直列化と一致させて差分を抑える。
set -euo pipefail

brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
[ -d "$brew_prefix/bin" ] && PATH="$brew_prefix/bin:$PATH"

input="$(cat)"
[ -z "$input" ] && input='{}'

managed="$(
  cat <<'JSON'
{{ includeTemplate "claude-settings.json" -}}
JSON
)"

printf '%s' "$input" | jq -S --argjson managed "$managed" '. * $managed'
