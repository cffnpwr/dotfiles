[alias]
	# jjの既定のエイリアス（b・ci・st）に相当する短縮名
	b = "branch"
	ci = "commit"
	st = "status"
	# jj log相当: 1行目にコミットID・作成者・コミット日時・ref・署名の検証結果、2行目に件名を表示する
	lg = "log --graph --date=iso-strict-local --format='%C(bold blue)%h%C(reset) %C(yellow)%ae%C(reset) %C(cyan)%cd%C(reset)%C(auto)%(decorate:prefix= ,suffix=,separator= ,tag=)%C(reset) %C(green)%G?%C(reset)%n%s'"
	# jj log-full相当: 1行目はlgと同じで署名の検証結果を除く。2行目に署名の詳細、続けてコミットメッセージ全文を表示する
	lg-full = "log --graph --date=iso-strict-local --format='%C(bold blue)%h%C(reset) %C(yellow)%ae%C(reset) %C(cyan)%cd%C(reset)%C(auto)%(decorate:prefix= ,suffix=,separator= ,tag=)%C(reset)%nSignature: %G? %GS %GK%n%B'"

[commit]
	gpgSign = true

[credential]
	helper = "manager"

[ghq]
	root = "~/git"

[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = "{{ .chezmoi.homeDir }}/.config/git/allowed_signers"

[init]
	defaultBranch = "main"

[tag]
	gpgSign = true

[user]
	email = "{{ .email }}"
	name = "{{ .name }}"
	signingKey = "{{ .chezmoi.homeDir }}/.ssh/{{ if eq .chezmoi.os "darwin" }}id_ecdsa_secretive.pub{{ else }}id_ed25519_sk.pub{{ end }}"
