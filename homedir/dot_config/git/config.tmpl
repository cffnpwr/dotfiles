[commit]
	gpgSign = true

[credential]
	helper = "manager"

[ghq]
	root = "~/git"

[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = "{{ .chezmoi.homeDir }}/.config/git/allowed_signers"

[init]
	defaultBranch = "main"

[tag]
	gpgSign = true

[user]
	email = "{{ .email }}"
	name = "{{ .name }}"
	signingKey = "{{ .chezmoi.homeDir }}/.ssh/{{ if eq .chezmoi.os "darwin" }}id_ecdsa_secretive.pub{{ else }}id_ed25519_sk.pub{{ end }}"
