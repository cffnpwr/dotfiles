{{- if eq .chezmoi.os "darwin" }}
# Homebrew
# brewのパスを解決する。優先度: PATH > HOMEBREW_PREFIX > 既定(/opt/homebrew)。
brew_path() {
  if command -v brew >/dev/null 2>&1; then
    command -v brew
  elif [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    printf '%s\n' "${HOMEBREW_PREFIX}/bin/brew"
  else
    printf '%s\n' "/opt/homebrew/bin/brew"
  fi
}
eval "$("$(brew_path)" shellenv)"
unset -f brew_path

# brew shellenvはbrewサブプロセス文脈(HOMEBREW_COMMAND_DEPTH設定済み)では出力を省略しsite-functionsをfpathへ追加しない。
# Homebrewのcompletionを確実に読むため明示追加する。重複は.zshrcのtypeset -U fpathが排除する。
fpath=("${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" $fpath)
{{- end }}
