{{ if eq .os "debian" -}}
#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "path.sh" . }}

{{ includeTemplate "log.sh" }}
STEP="bootstrap"
log "checking base packages (curl/gnupg/ca-certificates/golang-go)"

# 削除クリーンアップの基準となる手動導入パッケージのベースライン。
# 元のシステムを保護するため、最小パッケージの導入より前に、初回のみ記録する。
BASELINE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/apt-baseline"
if [[ ! -f "$BASELINE" ]]; then
  mkdir -p "$(dirname "$BASELINE")"
  apt-mark showmanual | sort >"$BASELINE"
fi

# golang-go: 25段以降のスクリプトは本体を Go 実装として go run で起動するため、
# それらより前にツールチェーンを用意する。go.mod が要求するバージョンは
# GOTOOLCHAIN=auto が自動取得するため、同梱版が 1.21 以上であればよい。
missing=()
for p in curl gnupg ca-certificates golang-go; do
  dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || missing+=("$p")
done
if ((${#missing[@]} > 0)); then
  log "installing base packages: ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
fi
{{- end }}
