{{ if eq .os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "path.sh" . }}

{{ includeTemplate "log.sh" }}
STEP="install-homebrew"
log "checking Homebrew"

# brew のパスを解決する。優先度: PATH > HOMEBREW_PREFIX > 既定(/opt/homebrew)。
brew_path() {
  if command -v brew >/dev/null 2>&1; then
    command -v brew
  elif [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    printf '%s\n' "${HOMEBREW_PREFIX}/bin/brew"
  else
    printf '%s\n' "/opt/homebrew/bin/brew"
  fi
}

brew_bin="$(brew_path)"
if [[ ! -x "$brew_bin" ]]; then
  log "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew_bin="$(brew_path)"
fi
eval "$("$brew_bin" shellenv)"

# 25段以降のスクリプトは本体を Go 実装として go run で起動するため、
# それらより前にツールチェーンを用意する。存在を検査し、無ければ導入する。
if ! command -v go >/dev/null 2>&1; then
  log "installing Go toolchain"
  brew install go
fi
{{- end }}
